{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle-seal.schema.json",
  "title": "Bundle seal",
  "type": "object",
  "required": [
    "kind", "schema_version", "lesson_html_sha256", "explainer_video_sha256",
    "scene_graph_sha256", "facts_sha256", "quality_policy_sha256",
    "required_receipts", "ready_for_delivery"
  ],
  "properties": {
    "kind": {"type": "string", "enum": ["verified-learning-bundle-seal"]},
    "schema_version": {"type": "integer"},
    "lesson_html_sha256": {"type": "string"},
    "explainer_video_sha256": {"type": "string"},
    "scene_graph_sha256": {"type": "string"},
    "facts_sha256": {"type": "string"},
    "quality_policy_sha256": {"type": "string"},
    "required_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sealed_at": {"type": "string"},
    "ready_for_delivery": {"type": "boolean"}
  }
}
