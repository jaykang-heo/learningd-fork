{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research.schema.json",
  "title": "Research map",
  "type": "object",
  "required": ["schema_version", "branches"],
  "properties": {
    "schema_version": {"type": "integer"},
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "decision_critical", "status"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "decision_critical": {"type": "boolean"},
          "status": {"type": "string", "enum": ["open", "closed", "abandoned"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
